# Database Configuration for Pipeline
# Supports PostgreSQL URL or SQLite:
# SQLite Example: sqlite:///data/materials.db
# PostgreSQL Example: postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/postgres

# Alternatively, individual connection variables:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
